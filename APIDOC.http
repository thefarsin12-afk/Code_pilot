Content-Type: application/json
Authorization: Token a131d17f962e5ad6ae8f17eca24ffc0b10384936

{
    "title":"write a pgm to add two numbers",

    "description":"write a pgm to add two numbers",

    "score":2,

    "smapleinput":"2+2",

    "sampleoutput":"output=4"

}

# api for retrieve question
###
GET http://127.0.0.1:8000/problem/question/5/
Accept: application/json
Authorization: Token a131d17f962e5ad6ae8f17eca24ffc0b10384936

